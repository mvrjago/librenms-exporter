# ============================================================
# Flask Application
# ============================================================

# Secret key untuk session Flask.
# Ganti dengan secret random yang kuat pada environment asli.
SECRET_KEY=change-this-to-a-random-secret-key

# Flask server
APP_HOST=0.0.0.0
APP_PORT=5000

# Jangan aktifkan debug pada production.
APP_DEBUG=false

# Direktori sementara untuk file CSV hasil export.
EXPORT_TEMP_DIR=/tmp


# ============================================================
# LibreNMS RRD
# ============================================================

# Lokasi RRD LibreNMS di server.
RRD_BASE_PATH=/opt/librenms-docker/compose/librenms/rrd

# Default output CPU exporter.
RRD_OUTPUT_CSV=cpu_combined.csv

# Default output Memory exporter.
MEMORY_OUTPUT_CSV=memory_combined.csv

# Berapa hari data RRD yang digunakan.
RRD_LOOKBACK_DAYS=30

# Resolusi data RRD dalam detik.
RRD_RESOLUTION=300


# ============================================================
# LibreNMS MySQL Database
# ============================================================

LIBRENMS_DB_HOST=localhost
LIBRENMS_DB_PORT=3306
LIBRENMS_DB_USER=librenms
LIBRENMS_DB_PASSWORD=change-this-password
LIBRENMS_DB_NAME=librenms


# ============================================================
# Storage Exporter
# ============================================================

# File output storage exporter.
STORAGE_OUTPUT_CSV=storage_combined.tsv