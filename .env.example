# ============================================================
# Flask Application
# ============================================================

# Secret key used to sign Flask sessions.
# Use a strong random value in production.
SECRET_KEY=change-this-to-a-random-secret-key

# Flask server bind address.
APP_HOST=0.0.0.0

# Flask server port.
APP_PORT=5000

# Enable Flask debug mode.
# Keep this disabled in production.
APP_DEBUG=false

# Temporary directory used to store generated export files.
EXPORT_TEMP_DIR=/tmp


# ============================================================
# LibreNMS RRD Configuration
# ============================================================

# Path to the LibreNMS RRD directory.
RRD_BASE_PATH=/opt/librenms-docker/compose/librenms/rrd

# Default output filename for the CPU exporter.
RRD_OUTPUT_CSV=cpu_combined.csv

# Default output filename for the memory exporter.
MEMORY_OUTPUT_CSV=memory_combined.csv

# Number of days of RRD data to analyze.
RRD_LOOKBACK_DAYS=30

# RRD data resolution in seconds.
RRD_RESOLUTION=300


# ============================================================
# LibreNMS MySQL Database
# ============================================================

# LibreNMS database hostname or IP address.
LIBRENMS_DB_HOST=localhost

# LibreNMS database port.
LIBRENMS_DB_PORT=3306

# LibreNMS database username.
LIBRENMS_DB_USER=librenms

# LibreNMS database password.
LIBRENMS_DB_PASSWORD=change-this-password

# LibreNMS database name.
LIBRENMS_DB_NAME=librenms


# ============================================================
# Storage Exporter
# ============================================================

# Output filename for the storage exporter.
STORAGE_OUTPUT_CSV=storage_combined.tsv